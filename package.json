{
  "name": "thenajs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build:ui --workspace @thenajs/flow",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json && npm run test:types",
    "start": "npm run build && tsx src/main.ts",
    "thena": "node packages/cli/dist/index.js"
  },
  "dependencies": {
    "@thenajs/core": "*",
    "@thenajs/tools": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@thenajs/cli": "*",
    "@types/node": "^20.19.43",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
