{
  "name": "thenajs",
  "version": "0.13.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build:ui --workspace @thenajs/flow",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json && npm run test:types && npm run typecheck:ui --workspace @thenajs/flow",
    "start": "npm run build && tsx src/main.ts",
    "thena": "node packages/cli/dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:clean": "npm run clean && npm run build",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@thenajs/core": "*",
    "@thenajs/tools": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@thenajs/cli": "*",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
